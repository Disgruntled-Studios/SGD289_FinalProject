PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _isUsable
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _itemName
      value: Note-The Lock Box
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _isReadable
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _noteContents
      value: "Dear Tony. \nTell me why you <color=red>CAN'T</color> make key copies
        for the LockBox? I swear if I have to come to you each time I need to <color=green>unlock</color>
        the lockbox I will just bring my <color=yellow>Gun</color> in and <color=yellow>Shoot</color>
        the lock off! \nLovingly from Aren."
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _additionalText
      value: 'Dear Tony.

        Tell me why we <color=red>CAN''T</color> copy the
        keys for the lockbox?

        I swear if I have to come to you each Time
        I need to <color=green>Unlock</color> the lockbox I will just bring my <color=yellow>Gun</color>
        and <color=yellow>Shoot</color> the lock off!

        Lovingly from Aren.'
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _additionalDialogue
      value: 
      objectReference: {fileID: 0}
