PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _isUsable
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _itemName
      value: "Note 2 \u2013 The door circuits are broken"
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _isReadable
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _noteContents
      value: "Dear Tony. \nThis is the third time this month I've needed to submit
        a maintenance request for these security doors the circuits that power them
        are messed up everytime I need to <color=green>Open</color> a door I have
        to open the circuit panel and <color=green>manually fix the nodes</color>
        it's getting ridiculous I almost got crushed under a door yesterday because
        another circuit blew.\nLovingly from Aren."
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _additionalText
      value: "We\u2019ve had six complaints about the door circuits cutting off SIX
        everytime we need to <color=green>Open</color> the doors we\u2019ve had to
        manually <color=green>Fix the circuit breaker nodes</color>. If we don\u2019t
        get maintenance out here asap someone is gonna get crushed under these doors
        I swear!\r\nFrustratingly from Aren.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1420863298652569307, guid: 798c6c1b320994c45b10f97d4704a362, type: 3}
      propertyPath: _additionalDialogue
      value: 
      objectReference: {fileID: 0}
