      propertyPath: _additionalText
      value: 'You''re not alone in here, so stay sharp.

        Press <i><color=red>Triangle</i></color>
        to interact with the world - open doors, search surroundings, and use items.

        Press
        <i><color=red>Start</i></color> to access your inventory - manage items,
        read collected documents, and check your status.

        Press <i><color=red>Circle</i></color>
        to crouch into tight spaces.

        Everything you need to survive...if
        you''re fast enough to use it. '
      objectReference: {fileID: 0}
