    - target: {fileID: 8118185164639072151, guid: de0c515be4fde374dac2bc88d24d6e98, type: 3}
      propertyPath: _itemName
      value: Folded Note
      objectReference: {fileID: 0}
    - target: {fileID: 8118185164639072151, guid: de0c515be4fde374dac2bc88d24d6e98, type: 3}
      propertyPath: _additionalText
      value: 'The hallway outside Reactor B is gone, completely melted. I think I''m
        the last one from Control still moving. I''ve got the cabinet key, Singh
        said the <color=red><i>code to the lockbox is filed in the second one from
        the right.</color></i> If that box really has a <color=red><i>sidearm</color></i>
        in it...that might be our only chance. If you find this, I didn''t make it,
        but the key still should still be on me.

        -Halverson'
      objectReference: {fileID: 0}
